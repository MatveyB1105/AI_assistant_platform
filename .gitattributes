# По умолчанию для всех текстовых файлов — использовать LF в репозитории
* text=auto eol=lf

# Явно указать LF для конфигурационных файлов (важно для Docker/Linux)
*.py text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
Dockerfile text eol=lf
docker-compose.yml text eol=lf

# Бинарные файлы — не трогать
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.lock binary